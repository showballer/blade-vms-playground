{
  "name": "@blade/desktop",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "BladeVMS 现场采集与分析工作台",
  "author": "BladeVMS",
  "main": "electron/field-main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5210",
    "start": "electron .",
    "prebuild": "node ../../scripts/prepare-desktop.mjs",
    "build": "vite build",
    "verify:windows-payload": "node ../../scripts/verify-windows-payload.cjs --write-nsis",
    "package:windows": "npm run verify:windows-payload && npm run build && electron-builder --win nsis zip --x64",
    "package:mac": "npm run build && electron-builder --mac dir --arm64"
  },
  "devDependencies": {
    "@blade/ui": "*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.2",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "cn.nmgut.bladevms",
    "productName": "BladeVMS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/field-*.cjs",
      "electron/local-auth.cjs",
      "electron/unified-auth.cjs",
      "electron/bootstrap-admin.json",
      "package.json"
    ],
    "beforePack": "build/before-pack.cjs",
    "extraResources": [
      { "from": "resources/acquisition", "to": "acquisition", "filter": ["**/*", "!.gitkeep"] },
      { "from": "resources/prerequisites", "to": "prerequisites", "filter": ["**/*", "!.gitkeep"] }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "BladeVMS-Setup-${version}-x64.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "runAfterFinish": false
    },
    "mac": {
      "target": "dir",
      "category": "public.app-category.productivity"
    }
  }
}
