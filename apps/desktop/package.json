{
  "name": "@blade/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BladeVMS 现场采集与分析工作台",
  "author": "BladeVMS",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5210",
    "start": "electron .",
    "prebuild": "node ../../scripts/prepare-desktop.mjs",
    "build": "vite build",
    "package:windows": "npm run build && electron-builder --win zip --x64",
    "package:mac": "npm run build && electron-builder --mac dir --arm64"
  },
  "dependencies": {
    "@blade/ui": "*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "vite": "8.2.2",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "cn.nmgut.bladevms",
    "productName": "BladeVMS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dir",
      "category": "public.app-category.productivity"
    }
  }
}
