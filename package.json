{
  "name": "blade-vms",
  "version": "1.0.0",
  "private": true,
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test:field": "node scripts/test-local-auth.cjs && node scripts/test-field-service.cjs && node scripts/test-field-sdk.cjs && node scripts/test-field-window.cjs && tsx packages/ui/src/field-desktop.test.tsx && tsx packages/ui/src/field-turntable-points.test.ts && tsx packages/ui/src/field-turntable-origin.test.ts && tsx packages/ui/src/field-capture-route.test.ts && tsx --tsconfig apps/desktop/tsconfig.json packages/ui/src/field-turntable-origin-control.test.tsx && tsx --tsconfig apps/desktop/tsconfig.json packages/ui/src/field-cycle-motion.test.tsx && tsx --tsconfig apps/desktop/tsconfig.json packages/ui/src/field-header-laser.test.tsx && tsx --tsconfig apps/desktop/tsconfig.json packages/ui/src/field-bending.test.tsx && tsx --tsconfig apps/desktop/tsconfig.json packages/ui/src/field-turntable-health.test.tsx && tsx --tsconfig apps/desktop/tsconfig.json packages/ui/src/field-drive-profile.test.tsx && tsx --tsconfig apps/desktop/tsconfig.json packages/ui/src/field-mechanical-home.test.tsx && tsx --tsconfig apps/desktop/tsconfig.json packages/ui/src/field-turntable-connection.test.tsx && tsx packages/ui/src/field-preset-position.test.ts && tsx --tsconfig apps/desktop/tsconfig.json packages/ui/src/field-recording-tasks.test.tsx && tsx --tsconfig apps/desktop/tsconfig.json packages/ui/src/field-capture-readiness.test.tsx",
    "test:single-point": "npm run test:single-point:ui && node scripts/test-field-service.cjs && node scripts/test-field-capture-main.cjs",
    "test:single-point:ui": "tsx --tsconfig apps/desktop/tsconfig.json packages/ui/src/field-single-point.test.tsx && tsx --tsconfig apps/desktop/tsconfig.json packages/ui/src/field-motion-trial.test.tsx",
    "test:unified-auth": "node scripts/test-unified-auth.cjs && node scripts/test-field-account-bridge.cjs",
    "test:unified-account-e2e": "node --env-file=apps/web/.env.local scripts/test-unified-account-e2e.mjs",
    "test:web-account": "node --env-file=apps/web/.env.local --import tsx scripts/test-web-account.ts",
    "test:bending-desktop": "electron scripts/bending-desktop-validation.cjs",
    "test:field-desktop": "npm run build -w @blade/desktop && electron scripts/field-desktop-smoke.cjs",
    "test:field-responsive": "npm run build -w @blade/desktop && electron scripts/field-responsive-smoke.cjs",
    "test:field-waveform": "npm run build -w @blade/desktop && electron scripts/field-waveform-smoke.cjs",
    "dev": "npm run dev -w @blade/web",
    "dev:desktop": "npm run dev -w @blade/desktop",
    "desktop": "npm run start -w @blade/desktop",
    "worker": "node --env-file=apps/web/.env.local scripts/backup-worker.mjs",
    "build": "npm run build -w @blade/web && npm run build -w @blade/desktop",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/desktop/tsconfig.json",
    "db:setup": "node scripts/setup-mysql.mjs",
    "db:migrate": "node --env-file=apps/web/.env.local scripts/migrate.mjs",
    "test:api": "node --env-file=apps/web/.env.local scripts/test-api.mjs",
    "test:admin-contracts": "node --env-file=apps/web/.env.local scripts/test-admin-contracts.mjs",
    "test:audit-query": "node --env-file=apps/web/.env.local scripts/test-audit-query.mjs",
    "test:developer-api": "tsx scripts/test-developer-api.ts",
    "test:web-role-markup": "tsx --tsconfig apps/web/tsconfig.json scripts/test-web-role-markup.tsx",
    "test:core": "tsx scripts/test-core.ts",
    "test:sync": "node scripts/prepare-desktop.mjs && node scripts/test-sync.cjs",
    "test:batch": "node scripts/prepare-desktop.mjs && node scripts/test-batch.cjs",
    "test:batch-api": "node scripts/prepare-desktop.mjs && node --env-file=apps/web/.env.local scripts/test-batch-api.mjs",
    "test:result-data": "tsx scripts/test-result-data.ts",
    "test:report": "tsx scripts/test-report-details.ts",
    "test:import": "node scripts/prepare-desktop.mjs && tsx scripts/test-import-data.ts",
    "test:import-api": "node --env-file=apps/web/.env.local scripts/test-import-api.mjs",
    "test:health": "tsx scripts/test-health-data.ts",
    "test:health-api": "node --env-file=apps/web/.env.local scripts/test-health-api.mjs",
    "test:health-trend": "tsx scripts/test-health-trend-data.ts",
    "test:health-trend-api": "node --env-file=apps/web/.env.local --import tsx scripts/test-health-trend-api.ts",
    "test:baseline": "tsx scripts/test-baseline-data.ts",
    "test:baseline-api": "node --env-file=apps/web/.env.local --import tsx scripts/test-baseline-api.ts",
    "test:rotation": "tsx scripts/test-rotation-data.ts",
    "simulate:rotation": "node tools/simulate-rotation.mjs",
    "test:analysis-desktop": "electron scripts/analysis-desktop-validation.cjs",
    "validate:analysis-desktop": "electron scripts/analysis-desktop-validation.cjs --interactive",
    "test:signal": "tsx scripts/test-signal-input.ts",
    "test:signal-api": "node --env-file=apps/web/.env.local --import tsx scripts/test-signal-api.ts",
    "test:rotation-api": "node --env-file=apps/web/.env.local scripts/test-rotation-api.mjs",
    "test:modal": "tsx scripts/test-modal-data.ts",
    "test:modal-api": "node scripts/prepare-desktop.mjs && node --env-file=apps/web/.env.local scripts/test-modal-api.mjs",
    "package:windows": "npm run package:windows -w @blade/desktop",
    "test:field-cloud-sync": "node scripts/test-field-cloud-sync.cjs",
    "test:field-capture-tracker": "node scripts/test-field-capture-tracker.cjs && node scripts/test-field-capture-main.cjs",
    "test:captures": "tsx scripts/test-capture-permissions.ts && tsx scripts/test-captures.ts",
    "test:capture-flow-e2e": "node --env-file=apps/web/.env.local scripts/test-capture-flow-e2e.mjs",
    "db:migrate-captures": "node --env-file=apps/web/.env.local scripts/migrate-captures.mjs",
    "test:capture-main-e2e": "node --env-file=apps/web/.env.local scripts/test-field-main-capture-e2e.mjs",
    "test:auto-follow": "tsx packages/ui/src/field-auto-follow-plan.test.ts && tsx --tsconfig apps/desktop/tsconfig.json packages/ui/src/field-auto-follow-config.test.ts && tsx --tsconfig apps/desktop/tsconfig.json packages/ui/src/field-auto-follow.test.tsx && tsx --tsconfig apps/desktop/tsconfig.json packages/ui/src/field-blade-summary.test.tsx && tsx --tsconfig apps/desktop/tsconfig.json packages/ui/src/field-auto-capture-list.test.tsx"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jszip": "^3.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
