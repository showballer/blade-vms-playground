# Install the completed file as /etc/bladevms/web.env, root:bladevms, mode 0640.
# This is a template; provision the password outside source control.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=blade_vms_playground
DB_USER=blade_vms_app
DB_PASSWORD=REPLACE_WITH_DEDICATED_DATABASE_PASSWORD
APP_ORIGIN=http://115.190.201.41:3000
BLADE_ANALYSIS_PYTHON=/opt/bladevms/venv/bin/python
BLADE_ANALYSIS_DATA_DIR=/var/lib/bladevms/web-rotation

# Enable only after installing and checking the existing 1.3.0 artifact.
# This is not a Windows build of the current source changes.
# BLADE_DESKTOP_WINDOWS_PATH=/var/lib/bladevms/downloads/BladeVMS-Setup-1.3.0-x64.exe
# BLADE_DESKTOP_WINDOWS_FILENAME=BladeVMS-Setup-1.3.0-x64.exe
# BLADE_DESKTOP_WINDOWS_VERSION=1.3.0

