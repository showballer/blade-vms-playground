# Install the completed file as /etc/bladevms/web.env, root:bladevms, mode 0640.
# This is a template; provision the password outside source control.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=blade_vms_playground
DB_USER=blade_vms_app
DB_PASSWORD=REPLACE_WITH_DEDICATED_DATABASE_PASSWORD
APP_ORIGIN=http://115.190.201.41:3000
BLADE_ANALYSIS_PYTHON=/opt/bladevms/venv/bin/python
BLADE_ANALYSIS_DATA_DIR=/var/lib/bladevms/web-rotation
BLADE_CAPTURE_DATA_DIR=/var/lib/bladevms/web-captures

# Enable only after the Windows 1.5.0 CI/installer checks and SHA-256 verification.
# Keep the previous artifact for rollback; update all three values together.
# BLADE_DESKTOP_WINDOWS_PATH=/var/lib/bladevms/downloads/BladeVMS-Setup-1.5.0-x64.exe
# BLADE_DESKTOP_WINDOWS_FILENAME=BladeVMS-Setup-1.5.0-x64.exe
# BLADE_DESKTOP_WINDOWS_VERSION=1.5.0

# Do not configure BOOTSTRAP_PASSWORD for this existing-data migration.
# NODE_ENV / TZ / NODE_OPTIONS are configured by the systemd units.
