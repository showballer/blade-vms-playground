[Unit]
Description=BladeVMS scheduled business snapshot check
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=bladevms
Group=bladevms
WorkingDirectory=/opt/bladevms/current
Environment=NODE_ENV=production
Environment=TZ=Asia/Shanghai
Environment=NODE_OPTIONS=--max-old-space-size=256
EnvironmentFile=/etc/bladevms/web.env
ExecStart=/usr/bin/node /opt/bladevms/current/scripts/backup-worker.mjs --once
TimeoutStartSec=180
TimeoutStopSec=15
KillMode=control-group
UMask=0077
TasksMax=64
MemoryAccounting=true
MemoryMax=384M
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bladevms-backup
